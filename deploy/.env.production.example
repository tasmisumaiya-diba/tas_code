# Copy this file to .env.production and replace the value with a randomly generated secret.
# Example: PowerShell: [guid]::NewGuid().ToString('N')
CODEBRIDGE_AUTH_TOKEN=replace-with-a-random-secret-at-least-16-characters

# Bind TLS only to loopback by default. Set to the host's private interface address
# only when remote clients must reach this host, and restrict ingress with its firewall.
CODEBRIDGE_HTTPS_BIND=127.0.0.1
CODEBRIDGE_HTTPS_PORT=8443
